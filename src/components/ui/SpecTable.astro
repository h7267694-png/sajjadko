---
// جدول مواصفات/خيارات (17.2 وبند 9): نص حقيقي، يتمرر أفقيًا داخل حاويته على الجوال.
export interface Props {
  caption: string;
  headers: string[];
  rows: string[][];
}
const { caption, headers, rows } = Astro.props;
---

<div class="overflow-x-auto my-6">
  <table class="w-full text-start text-sm md:text-base border-collapse">
    <caption class="text-start font-semibold mb-2">{caption}</caption>
    <thead>
      <tr class="border-b-2 border-primary">
        {
          headers.map((h) => (
            <th scope="col" class="py-2 pe-4 text-start font-semibold">
              {h}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        rows.map(([first, ...rest]) => (
          <tr class="border-b border-gray-200 dark:border-slate-800">
            <th scope="row" class="py-2 pe-4 text-start font-medium">
              {first}
            </th>
            {rest.map((c) => (
              <td class="py-2 pe-4">{c}</td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
