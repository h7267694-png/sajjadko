---
// بطاقة منتج بأسلوب المتجر (الرئيسية والعروض): صورة، شارة النوع أو العرض، الاسم، السعر، التفاصيل وواتساب.
// الصور كسولة وبأولوية منخفضة دائمًا: عنصر LCP في الرئيسية نصي (16.2)، فلا تنافسه البطاقات.
import { Image } from 'astro:assets';
import { getSettings } from '~/utils/site';
import { productHref, priceLine, activeOffer, kwd, type ProductEntry } from '~/utils/products';
import { CATEGORY_LABELS, PRICE_UNIT_LABELS } from '~/utils/taxonomy';
import type { Locale } from '~/utils/site';

export interface Props {
  entry: ProductEntry;
  lang: Locale;
  pageName: string;
  /** في شريط أفقي (العروض) بدل الشبكة */
  inRow?: boolean;
  /** يعرض سعر العرض وشارته (قسم العروض فقط؛ الشبكة تعرض السعر الأساسي دائمًا فلا يبقى عرض منتهٍ ظاهرًا) */
  withOffer?: boolean;
  /** مخفي حتى «عرض المزيد» في رواق الرئيسية (صوره الكسولة لا تُحمَّل وهو مخفي) */
  extra?: boolean;
  /** بلا شارة النوع (داخل رواق القسم، الاسم ظاهر في لوحته) */
  noBadge?: boolean;
}

const { entry, lang, pageName, inRow = false, withOffer = false, extra = false, noBadge = false } = Astro.props;
const ar = lang === 'ar';
const d = entry.data;
const tx = d[lang]!;
const img = d.images[0];
const href = productHref(lang, entry.id);
const offer = withOffer ? activeOffer(entry) : undefined;
const until = offer?.until.toISOString().slice(0, 10);
const settings = await getSettings();
const msg = ar
  ? `مرحبًا، أرغب بالاستفسار عن ${tx.name}${offer ? ' (العرض)' : ''}. المقاس: [الطول × العرض]. (من صفحة: ${pageName})`
  : `Hello, I would like to ask about ${tx.name}${offer ? ' (offer)' : ''}. Size: [length × width]. (From page: ${pageName})`;
const wa = settings?.whatsapp ? `https://wa.me/${settings.whatsapp}?text=${encodeURIComponent(msg)}` : undefined;
---

<li
  class:list={[
    'store-card group relative flex flex-col overflow-hidden rounded-xl border border-gray-200 bg-white dark:border-slate-700 dark:bg-slate-900',
    inRow && 'snap-start shrink-0 w-[70%] sm:w-[42%] lg:w-[23.5%]',
  ]}
  data-cat={d.category}
  data-offer-until={until}
  data-extra={extra ? '' : undefined}
  hidden={extra}
>
  <a href={href} class="block relative bg-gray-50 dark:bg-slate-800">
    {
      img && (
        <Image
          src={img.src}
          alt={img.alt[lang] ?? tx.name}
          widths={[240, 360, 480]}
          sizes={
            inRow
              ? '(min-width: 1024px) 240px, (min-width: 640px) 42vw, 70vw'
              : '(min-width: 1024px) 240px, (min-width: 640px) 31vw, 48vw'
          }
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          class="w-full aspect-square object-cover transition-transform duration-300 motion-safe:group-hover:scale-105"
        />
      )
    }
    {
      offer ? (
        <span class="absolute top-2 start-2 rounded-md bg-accent px-2 py-0.5 text-xs font-bold text-white">
          {(ar ? offer.label.ar : offer.label.en) ?? (ar ? 'عرض' : 'Offer')}
        </span>
      ) : noBadge ? null : (
        <span class="absolute top-2 start-2 rounded-md bg-white/90 dark:bg-slate-900/90 px-2 py-0.5 text-xs font-semibold text-primary dark:text-white">
          {CATEGORY_LABELS[d.category][lang]}
        </span>
      )
    }
  </a>
  <div class="flex grow flex-col gap-1.5 p-3">
    <h3 class="text-sm md:text-base font-semibold leading-snug">
      <a href={href} class="hover:underline">{tx.name}</a>
    </h3>
    {
      offer ? (
        <p class="text-sm">
          <span class="font-bold text-accent">
            {kwd(offer.price)} {ar ? 'د.ك' : 'KWD'}
          </span>{' '}
          <span class="text-muted text-xs">{PRICE_UNIT_LABELS[offer.unit][lang]}</span>
          {offer.was && (
            <s class="ms-1 text-xs text-muted">
              {kwd(offer.was)} {ar ? 'د.ك' : 'KWD'}
            </s>
          )}
          <span class="block text-xs text-muted">
            {ar ? 'حتى' : 'Until'} <bdi dir="ltr">{until}</bdi>
          </span>
        </p>
      ) : (
        <p class="text-sm text-muted">{priceLine(entry, lang)}</p>
      )
    }
    <div class="mt-auto flex gap-2 pt-1">
      <a href={href} class="btn-secondary grow inline-flex justify-center min-h-11 text-sm px-3 py-2">
        {ar ? 'التفاصيل' : 'Details'}
      </a>
      {
        wa && (
          <a
            href={wa}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center min-h-11 min-w-11 rounded-lg bg-primary text-white"
            aria-label={ar ? `اسأل عن ${tx.name} عبر واتساب` : `Ask about ${tx.name} on WhatsApp`}
            data-wa-type="product"
            data-wa-position="card"
            data-wa-source={tx.name}
          >
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
              <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4a.5.5 0 0 0 0-.4l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.2-.2-.5-.3Z" />
            </svg>
          </a>
        )
      }
    </div>
  </div>
</li>
