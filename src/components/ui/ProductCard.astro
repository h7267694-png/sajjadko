---
// بطاقة منتج بأسلوب المتجر (الرئيسية والعروض): صورة مربعة بشارة النوع أو منطقة العمل، الاسم، السعر بارزًا، وزر واتساب.
// الصور كسولة وبأولوية منخفضة دائمًا: عنصر LCP في الرئيسية صورة السلايدر الأولى، فلا تنافسها البطاقات.
// الصورة والاسم رابطان لصفحة المنتج (نفس الروابط الداخلية السابقة).
import { Image } from 'astro:assets';
import { getSettings } from '~/utils/site';
import { productHref, activeOffer, kwd, type ProductEntry } from '~/utils/products';
import { CATEGORY_LABELS, PRICE_UNIT_LABELS } from '~/utils/taxonomy';
import areasData from '~/data/kuwait-areas.json';
import type { Locale } from '~/utils/site';

export interface Props {
  entry: ProductEntry;
  lang: Locale;
  pageName: string;
  /** في شريط أفقي (العروض) بدل الشبكة */
  inRow?: boolean;
  /** يعرض سعر العرض وشارته (قسم العروض فقط؛ الشبكة تعرض السعر الأساسي دائمًا فلا يبقى عرض منتهٍ ظاهرًا) */
  withOffer?: boolean;
  /** مخفي حتى «عرض المزيد» في رواق الرئيسية (صوره الكسولة لا تُحمَّل وهو مخفي) */
  extra?: boolean;
  /** بلا شارة النوع (داخل رواق القسم، الاسم ظاهر في لوحته). شارة منطقة العمل تبقى */
  noBadge?: boolean;
}

const { entry, lang, pageName, inRow = false, withOffer = false, extra = false, noBadge = false } = Astro.props;
const ar = lang === 'ar';
const d = entry.data;
const tx = d[lang]!;
const img = d.images[0];
const href = productHref(lang, entry.id);
const offer = withOffer ? activeOffer(entry) : undefined;
const until = offer?.until.toISOString().slice(0, 10);
const cur = ar ? 'د.ك' : 'KWD';
const unit = (u: keyof typeof PRICE_UNIT_LABELS) => PRICE_UNIT_LABELS[u][lang];
// السعر: الرقم بارز والوحدة سطر صغير (نفس بيانات priceLine)
const price = d.price
  ? { amount: `${kwd(d.price.amount)} ${cur}`, unit: unit(d.price.unit) }
  : d.priceRange
    ? {
        amount: ar
          ? `من ${kwd(d.priceRange.min)} إلى ${kwd(d.priceRange.max)} ${cur}`
          : `${kwd(d.priceRange.min)}–${kwd(d.priceRange.max)} ${cur}`,
        unit: unit(d.priceRange.unit),
      }
    : undefined;
// شارة العمل المنفذ: اسم المنطقة فقط (معلومة حقيقية من latestWork)
const work =
  d.latestWork?.show && d.latestWork.area ? areasData.areas.find((a) => a.id === d.latestWork!.area) : undefined;
const settings = await getSettings();
const msg = ar
  ? `مرحبًا، أرغب بالاستفسار عن ${tx.name}${offer ? ' (العرض)' : ''}. المقاس: [الطول × العرض]. (من صفحة: ${pageName})`
  : `Hello, I would like to ask about ${tx.name}${offer ? ' (offer)' : ''}. Size: [length × width]. (From page: ${pageName})`;
const wa = settings?.whatsapp ? `https://wa.me/${settings.whatsapp}?text=${encodeURIComponent(msg)}` : undefined;
---

<li
  class:list={['store-card pc group', inRow && 'snap-start shrink-0 w-[70%] sm:w-[42%] lg:w-[23.5%]']}
  data-cat={d.category}
  data-offer-until={until}
  data-extra={extra ? '' : undefined}
  hidden={extra}
>
  <a href={href} class="pc-media" tabindex="-1" aria-hidden="true">
    {
      img && (
        <Image
          src={img.src}
          alt={img.alt[lang] ?? tx.name}
          widths={[240, 360, 480]}
          sizes={
            inRow
              ? '(min-width: 1024px) 240px, (min-width: 640px) 42vw, 70vw'
              : '(min-width: 1024px) 240px, (min-width: 640px) 31vw, 48vw'
          }
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          class="pc-img"
        />
      )
    }
    <span class="pc-badges">
      {
        offer ? (
          <span class="pc-badge pc-badge--offer">
            {(ar ? offer.label.ar : offer.label.en) ?? (ar ? 'عرض' : 'Offer')}
          </span>
        ) : (
          !noBadge && <span class="pc-badge">{CATEGORY_LABELS[d.category][lang]}</span>
        )
      }
      {
        work && (
          <span class="pc-badge pc-badge--work">
            <svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"
              />
            </svg>
            {ar ? work.ar : work.en}
          </span>
        )
      }
    </span>
  </a>
  <div class="pc-body">
    <h3 class="pc-title">
      <a href={href}>{tx.name}</a>
    </h3>
    {
      offer ? (
        <p class="pc-price">
          <span class="pc-amount pc-amount--offer">
            {kwd(offer.price)} {cur}
          </span>
          {offer.was && (
            <s class="pc-was">
              {kwd(offer.was)} {cur}
            </s>
          )}
          <span class="pc-unit">
            {PRICE_UNIT_LABELS[offer.unit][lang]} · {ar ? 'حتى' : 'until'} <bdi dir="ltr">{until}</bdi>
          </span>
        </p>
      ) : price ? (
        <p class="pc-price">
          <span class="pc-amount">{price.amount}</span>
          <span class="pc-unit">{price.unit}</span>
        </p>
      ) : (
        <p class="pc-price">
          <span class="pc-unit">{ar ? 'السعر حسب المقاس' : 'Priced by size'}</span>
        </p>
      )
    }
    {
      wa && (
        <a
          href={wa}
          target="_blank"
          rel="noopener noreferrer"
          class="pc-wa"
          aria-label={ar ? `اسأل عن ${tx.name} عبر واتساب` : `Ask about ${tx.name} on WhatsApp`}
          data-wa-type="product"
          data-wa-position="card"
          data-wa-source={tx.name}
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4a.5.5 0 0 0 0-.4l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.2-.2-.5-.3Z" />
          </svg>
          <span class="sm:hidden">{ar ? 'واتساب' : 'WhatsApp'}</span>
          <span class="hidden sm:inline">{ar ? 'اطلب عبر واتساب' : 'Order on WhatsApp'}</span>
        </a>
      )
    }
  </div>
</li>

<style>
  .pc {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid var(--brand-line);
    background: var(--aw-color-bg-page);
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .pc:hover {
    border-color: var(--brand-gold);
    box-shadow: 0 10px 24px -12px rgb(2 46 79 / 0.35);
  }
  .pc-media {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--brand-sand);
  }
  .pc-img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    transition: transform 0.3s;
  }
  @media (prefers-reduced-motion: no-preference) {
    .pc:hover .pc-img {
      transform: scale(1.04);
    }
  }
  .pc-badges {
    position: absolute;
    top: 0.5rem;
    inset-inline-start: 0.5rem;
    inset-inline-end: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    pointer-events: none;
  }
  .pc-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: var(--brand-navy);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1.6;
  }
  .pc-badge--work {
    background: rgb(255 255 255 / 0.94);
    color: var(--brand-navy);
  }
  .pc-badge--work svg {
    color: var(--brand-gold-text);
  }
  .pc-badge--offer {
    background: var(--brand-gold);
    color: var(--brand-navy);
  }
  .pc-body {
    display: flex;
    flex-grow: 1;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.7rem 0.75rem 0.75rem;
  }
  .pc-title {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.55;
    color: var(--aw-color-text-heading);
  }
  .pc-title a:hover {
    text-decoration: underline;
  }
  .pc-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.4rem;
  }
  .pc-amount {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--aw-color-text-heading);
  }
  .pc-amount--offer {
    color: var(--brand-gold-text);
  }
  .pc-was {
    font-size: 0.75rem;
    color: var(--aw-color-text-muted);
  }
  .pc-unit {
    flex-basis: 100%;
    font-size: 0.75rem;
    color: var(--aw-color-text-muted);
  }
  .pc-wa {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    margin-top: auto;
    padding: 0.5rem 0.6rem;
    border-radius: 0.75rem;
    background: var(--brand-navy);
    color: #fff;
    font-size: 0.82rem;
    font-weight: 700;
    white-space: nowrap;
    transition: background-color 0.2s;
  }
  .pc-wa:hover {
    background: var(--aw-color-secondary);
  }
  .pc-wa:focus-visible,
  .pc-title a:focus-visible {
    outline: 3px solid var(--brand-gold);
    outline-offset: 2px;
  }
  :global(.dark) .pc-wa {
    background: var(--aw-color-primary);
  }
  @media (min-width: 768px) {
    .pc-title {
      font-size: 0.95rem;
    }
    .pc-amount {
      font-size: 1.05rem;
    }
    .pc-body {
      padding: 0.85rem 0.9rem 0.9rem;
    }
  }
</style>
