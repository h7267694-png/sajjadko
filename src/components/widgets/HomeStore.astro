---
// واجهة المتجر في الرئيسية: تسوق حسب القسم، العروض (إن وُجد عرض ساري)، وكل المنتجات ببطاقات وتصفية بالنوع.
// لا صورة فوق الطية: كل الصور كسولة بأولوية منخفضة، فيبقى LCP نصيًا (16.2). JS صغير جدًا ومضمّن.
import { Image } from 'astro:assets';
import ProductCard from '~/components/ui/ProductCard.astro';
import { getProducts, activeOffer, productHref } from '~/utils/products';
import { CATEGORY_LABELS } from '~/utils/taxonomy';
import type { Locale } from '~/utils/site';

export interface Tile {
  /** مفتاح القسم (translationKey): صورته من src/assets/sections/<key>.webp إن وُجدت */
  key: string;
  t: string;
  href: string;
  /** slug منتج تُؤخذ صورته الأولى للقسم */
  img?: string;
}
export interface Props {
  lang: Locale;
  pageName: string;
  tiles: Tile[];
}

const { lang, pageName, tiles } = Astro.props;
const ar = lang === 'ar';
const products = (await getProducts(lang)).sort((a, b) => a.data.sku.localeCompare(b.data.sku));
const byId = new Map(products.map((p) => [p.id, p]));
// صورة القسم الخاصة أولًا (src/assets/sections/<key>.webp)، وإلا صورة منتج من القسم
const sectionImgs = import.meta.glob<{ default: ImageMetadata }>('/src/assets/sections/*.{jpg,jpeg,png,webp}', {
  eager: true,
});
const sectionImg = (key: string) =>
  Object.entries(sectionImgs).find(
    ([path]) =>
      path
        .split('/')
        .pop()!
        .replace(/\.\w+$/, '') === key
  )?.[1].default;
const offers = products.filter((p) => activeOffer(p));
const cats = [...new Set(products.map((p) => p.data.category))];

const t = ar
  ? {
      shop: 'تسوق حسب القسم',
      offers: 'العروض',
      offersSub: 'عروض حقيقية لفترة محدودة بتاريخ انتهاء واضح',
      all: 'كل المنتجات',
      allChip: 'الكل',
      filter: 'تصفية المنتجات حسب النوع',
    }
  : {
      shop: 'Shop by category',
      offers: 'Offers',
      offersSub: 'Real limited-time offers with a clear end date',
      all: 'All products',
      allChip: 'All',
      filter: 'Filter products by type',
    };

const schema = products.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: t.all,
      itemListElement: products.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: p.data[lang]!.name,
        url: new URL(productHref(lang, p.id), Astro.site).href,
      })),
    }
  : null;

// تصفية بالنوع + إخفاء العروض المنتهية قبل البناء اليومي التالي
const JS = `(function(){var g=document.querySelector('[data-store-grid]'),c=document.querySelector('[data-store-chips]');if(g&&c)c.addEventListener('click',function(e){var b=e.target.closest('button');if(!b)return;c.querySelectorAll('button').forEach(function(x){x.setAttribute('aria-pressed',x===b)});var k=b.dataset.cat;g.querySelectorAll('[data-cat]').forEach(function(li){li.hidden=!!k&&li.dataset.cat!==k})});var d=new Date().toISOString().slice(0,10),s=document.querySelector('[data-offers]');if(s){s.querySelectorAll('[data-offer-until]').forEach(function(li){if(li.dataset.offerUntil<d)li.remove()});if(!s.querySelector('[data-offer-until]'))s.remove()}})();`;
---

{
  tiles.length > 0 && (
    <section class="mt-8 mb-10" aria-labelledby="shop-cats">
      <h2 id="shop-cats" class="text-2xl md:text-3xl font-bold mb-4">
        {t.shop}
      </h2>
      <ul class="flex gap-3 overflow-x-auto snap-x pb-2 -mx-4 px-4 md:mx-0 md:px-0 md:grid md:grid-cols-4 lg:grid-cols-6 md:overflow-visible">
        {tiles.map((x) => {
          const src = sectionImg(x.key) ?? (x.img ? byId.get(x.img)?.data.images[0]?.src : undefined);
          return (
            <li class="snap-start shrink-0 w-28 md:w-auto">
              <a href={x.href} class="group block text-center">
                <span class="block overflow-hidden rounded-xl bg-primary/5 dark:bg-slate-800 aspect-square">
                  {src ? (
                    <Image
                      src={src}
                      alt={x.t}
                      widths={[160, 240]}
                      sizes="(min-width: 1024px) 150px, (min-width: 768px) 22vw, 112px"
                      loading="lazy"
                      decoding="async"
                      fetchpriority="low"
                      class="w-full h-full object-cover transition-transform duration-300 motion-safe:group-hover:scale-105"
                    />
                  ) : (
                    <span class="flex h-full items-center justify-center text-3xl text-primary/60" aria-hidden="true">
                      ▦
                    </span>
                  )}
                </span>
                <span class="mt-2 block text-sm font-semibold leading-snug group-hover:underline">{x.t}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )
}

{
  offers.length > 0 && (
    <section class="my-10 rounded-2xl bg-accent/10 p-4 md:p-6" aria-labelledby="offers" data-offers>
      <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
        <h2 id="offers" class="text-2xl md:text-3xl font-bold">
          {t.offers}
        </h2>
        <p class="text-sm text-muted">{t.offersSub}</p>
      </div>
      <ul class="flex gap-3 overflow-x-auto snap-x snap-mandatory pb-2">
        {offers.map((p) => (
          <ProductCard entry={p} lang={lang} pageName={pageName} inRow withOffer />
        ))}
      </ul>
    </section>
  )
}

{
  products.length > 0 && (
    <section class="my-10" aria-labelledby="all-products">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <h2 id="all-products" class="text-2xl md:text-3xl font-bold">
          {t.all}
        </h2>
        {cats.length > 1 && (
          <div class="flex flex-wrap gap-2" role="group" aria-label={t.filter} data-store-chips>
            <button type="button" class="store-chip" aria-pressed="true">
              {t.allChip}
            </button>
            {cats.map((c) => (
              <button type="button" class="store-chip" aria-pressed="false" data-cat={c}>
                {CATEGORY_LABELS[c][lang]}
              </button>
            ))}
          </div>
        )}
      </div>
      <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4" data-store-grid>
        {products.map((p) => (
          <ProductCard entry={p} lang={lang} pageName={pageName} />
        ))}
      </ul>
      {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    </section>
  )
}

<script is:inline set:html={JS} />

<style>
  .store-chip {
    min-height: 2.75rem;
    padding: 0 1rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--aw-color-primary) 30%, transparent);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .store-chip[aria-pressed='true'] {
    background: var(--aw-color-primary);
    color: #fff;
    border-color: var(--aw-color-primary);
  }
</style>
