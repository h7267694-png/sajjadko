---
// واجهة المتجر في الرئيسية: تسوق حسب القسم، العروض (إن وُجد عرض ساري)، ثم رواق لكل نوع: لوحة القسم ومنتجان،
// وزر «عرض المزيد» يكشف بقية المنتجات. المخفي بـhidden لا تُحمَّل صوره (كسولة)، وروابطه في HTML للزواحف.
// LCP نصي (16.2): كل الصور كسولة بأولوية منخفضة (التحميل الفوري لصور الأقسام أخّر خط العنوان فأبطأ LCP في القياس).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ProductCard from '~/components/ui/ProductCard.astro';
import { getProducts, activeOffer, productHref } from '~/utils/products';
import { CATEGORY_LABELS } from '~/utils/taxonomy';
import { getCollection } from 'astro:content';
import { pageHref } from '~/utils/pages';
import type { Locale } from '~/utils/site';

export interface Tile {
  /** مفتاح القسم (translationKey): صورته من src/assets/sections/<key>.webp إن وُجدت */
  key: string;
  t: string;
  href: string;
  /** slug منتج تُؤخذ صورته الأولى للقسم */
  img?: string;
}
export interface Props {
  lang: Locale;
  pageName: string;
  tiles: Tile[];
}

const { lang, pageName, tiles } = Astro.props;
const ar = lang === 'ar';
const products = (await getProducts(lang)).sort((a, b) => a.data.sku.localeCompare(b.data.sku));
const byId = new Map(products.map((p) => [p.id, p]));
// صورة القسم الخاصة أولًا (src/assets/sections/<key>.webp)، وإلا صورة منتج من القسم
const sectionImgs = import.meta.glob<{ default: ImageMetadata }>('/src/assets/sections/*.{jpg,jpeg,png,webp}', {
  eager: true,
});
const sectionImg = (key: string) =>
  Object.entries(sectionImgs).find(
    ([path]) =>
      path
        .split('/')
        .pop()!
        .replace(/\.\w+$/, '') === key
  )?.[1].default;
const offers = products.filter((p) => activeOffer(p));

// رواق لكل نوع: الأعمال المنفذة أولًا (الأحدث)، ثم بالرمز. الأنواع بالأكثر منتجات.
const CAT_PAGE: Record<string, string> = {
  moquette: 'moquette',
  carpet: 'by-meter',
  zawali: 'zawali',
  'mosque-carpet': 'mosque-carpets',
  'carpet-tiles': 'carpet-tiles',
  'red-carpet': 'red-carpet',
};
const CAT_LINE: Record<string, { ar: string; en: string }> = {
  moquette: { ar: 'من الجدار للجدار، يُقص على مقاس المكان ويُركّب', en: 'Wall to wall, cut to your room and fitted' },
  carpet: { ar: 'سجاد بالمتر سادة ومشجر، وممرات ودرج', en: 'Plain and patterned by the metre, runners and stairs' },
  zawali: { ar: 'جاهزة، وبالمتر، وتفصيل على المقاس', en: 'Ready-made, by the metre and made to size' },
  'mosque-carpet': { ar: 'بخطوط الصفوف، يُقص على مساحة المسجد', en: 'With prayer rows, cut to the mosque' },
  'carpet-tiles': { ar: 'بلاط 40×40 للمكاتب والمساحات التجارية', en: '40×40 tiles for offices and commercial spaces' },
  'red-carpet': { ar: 'للمناسبات والاستقبال', en: 'For events and receptions' },
};
const pages = (await getCollection('pages')).filter((e) => e.data.status === 'published' && e.data.lang === lang);
const workDate = (p: (typeof products)[number]) => {
  const w = p.data.latestWork;
  return w?.show && w.date ? +new Date(w.date) : 0;
};
const aisles = [...new Set(products.map((p) => p.data.category))]
  .map((c) => {
    const items = products.filter((p) => p.data.category === c).sort((a, b) => workDate(b) - workDate(a));
    const page = pages.find((e) => e.data.translationKey === CAT_PAGE[c]);
    return {
      c,
      items,
      href: page ? pageHref(lang, page.data.urlPath) : undefined,
      img: sectionImg(CAT_PAGE[c]) ?? items[0]?.data.images[0]?.src,
    };
  })
  .sort((a, b) => b.items.length - a.items.length);
const SHOWN = 2;

const t = ar
  ? {
      shop: 'تسوق حسب القسم',
      offers: 'العروض',
      offersSub: 'عروض حقيقية لفترة محدودة بتاريخ انتهاء واضح',
      all: 'منتجاتنا',
      more: (n: number) => `عرض المزيد (${n})`,
      less: 'عرض أقل',
      page: 'صفحة القسم',
      count: (n: number) => (n === 1 ? 'منتج واحد' : n === 2 ? 'منتجان' : n <= 10 ? `${n} منتجات` : `${n} منتجًا`),
    }
  : {
      shop: 'Shop by category',
      offers: 'Offers',
      offersSub: 'Real limited-time offers with a clear end date',
      all: 'Our products',
      more: (n: number) => `Show more (${n})`,
      less: 'Show less',
      page: 'Section page',
      count: (n: number) => `${n} product${n === 1 ? '' : 's'}`,
    };

const schema = products.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: t.all,
      itemListElement: products.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: p.data[lang]!.name,
        url: new URL(productHref(lang, p.id), Astro.site).href,
      })),
    }
  : null;

// «عرض المزيد» لكل رواق + إخفاء العروض المنتهية قبل البناء اليومي التالي
const JS = `(function(){document.querySelectorAll('[data-aisle-more]').forEach(function(b){b.addEventListener('click',function(){var open=b.getAttribute('aria-expanded')!=='true',l=document.getElementById(b.getAttribute('aria-controls'));l.querySelectorAll('[data-extra]').forEach(function(li){li.hidden=!open});b.setAttribute('aria-expanded',open);b.textContent=open?b.dataset.less:b.dataset.more;if(!open)l.closest('section').scrollIntoView({block:'start'})})});var d=new Date().toISOString().slice(0,10),s=document.querySelector('[data-offers]');if(s){s.querySelectorAll('[data-offer-until]').forEach(function(li){if(li.dataset.offerUntil<d)li.remove()});if(!s.querySelector('[data-offer-until]'))s.remove()}})();`;
---

{
  tiles.length > 0 && (
    <section class="mt-8 mb-10" aria-labelledby="shop-cats">
      <h2 id="shop-cats" class="text-2xl md:text-3xl font-bold mb-4">
        {t.shop}
      </h2>
      <ul class="flex gap-3 overflow-x-auto snap-x pb-2 -mx-4 px-4 md:mx-0 md:px-0 md:grid md:grid-cols-4 lg:grid-cols-6 md:overflow-visible">
        {tiles.map((x) => {
          const src = sectionImg(x.key) ?? (x.img ? byId.get(x.img)?.data.images[0]?.src : undefined);
          return (
            <li class="snap-start shrink-0 w-28 md:w-auto">
              <a href={x.href} class="group block text-center">
                <span class="block overflow-hidden rounded-xl bg-primary/5 dark:bg-slate-800 aspect-square">
                  {src ? (
                    <Image
                      src={src}
                      alt={x.t}
                      widths={[120, 240]}
                      sizes="(min-width: 1024px) 150px, (min-width: 768px) 22vw, 112px"
                      loading="lazy"
                      decoding="async"
                      fetchpriority="low"
                      class="w-full h-full object-cover transition-transform duration-300 motion-safe:group-hover:scale-105"
                    />
                  ) : (
                    <span class="flex h-full items-center justify-center text-3xl text-primary/60" aria-hidden="true">
                      ▦
                    </span>
                  )}
                </span>
                <span class="mt-2 block text-sm font-semibold leading-snug group-hover:underline">{x.t}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )
}

{
  offers.length > 0 && (
    <section class="my-10 rounded-2xl bg-accent/10 p-4 md:p-6" aria-labelledby="offers" data-offers>
      <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
        <h2 id="offers" class="text-2xl md:text-3xl font-bold">
          {t.offers}
        </h2>
        <p class="text-sm text-muted">{t.offersSub}</p>
      </div>
      <ul class="flex gap-3 overflow-x-auto snap-x snap-mandatory pb-2">
        {offers.map((p) => (
          <ProductCard entry={p} lang={lang} pageName={pageName} inRow withOffer />
        ))}
      </ul>
    </section>
  )
}

{
  aisles.length > 0 && (
    <section class="my-10" aria-labelledby="all-products">
      <h2 id="all-products" class="text-2xl md:text-3xl font-bold mb-5">
        {t.all}
      </h2>
      <div class="space-y-8 md:space-y-10">
        {aisles.map((a) => {
          const label = CATEGORY_LABELS[a.c][lang];
          const rest = a.items.length - SHOWN;
          const listId = `aisle-${a.c}`;
          return (
            <section class="aisle" aria-labelledby={`${listId}-h`}>
              <ul id={listId} class="aisle-grid">
                <li class="aisle-sign">
                  {a.img && (
                    <Image
                      src={a.img}
                      alt={label}
                      widths={[96, 192, 480, 720]}
                      sizes="(min-width: 1024px) 480px, 64px"
                      loading="lazy"
                      decoding="async"
                      class="aisle-thumb"
                    />
                  )}
                  <div class="aisle-text min-w-0">
                    <h3 id={`${listId}-h`} class="text-xl md:text-2xl font-bold leading-tight">
                      {a.href ? (
                        <a href={a.href} class="hover:underline">
                          {label}
                        </a>
                      ) : (
                        label
                      )}
                    </h3>
                    <p class="mt-1 text-sm opacity-85">{CAT_LINE[a.c]?.[lang]}</p>
                    <p class="mt-3 text-xs font-semibold aisle-count">{t.count(a.items.length)}</p>
                  </div>
                  {a.href && (
                    <a href={a.href} class="aisle-link">
                      {t.page}
                    </a>
                  )}
                </li>
                {a.items.map((p, i) => (
                  <ProductCard entry={p} lang={lang} pageName={pageName} extra={i >= SHOWN} noBadge />
                ))}
              </ul>
              {rest > 0 && (
                <button
                  type="button"
                  class="aisle-more"
                  aria-expanded="false"
                  aria-controls={listId}
                  data-aisle-more
                  data-more={t.more(rest)}
                  data-less={t.less}
                >
                  {t.more(rest)}
                </button>
              )}
            </section>
          );
        })}
      </div>
      {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    </section>
  )
}

<script is:inline set:html={JS} />

<style>
  /* رواق المنتجات: لوحة القسم بلون الهوية بجانب منتجين، والباقي يُكشف بالزر */
  .aisle-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .aisle-sign {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.875rem 1rem;
    border-radius: 1rem;
    background: var(--aw-color-primary);
    color: #fff;
    border-inline-start: 6px solid var(--aw-color-accent);
  }
  .aisle-thumb {
    width: 64px;
    height: 64px;
    flex: none;
    border-radius: 0.75rem;
    object-fit: cover;
    outline: 2px solid rgb(255 255 255 / 0.25);
  }
  .aisle-count {
    display: inline-block;
    padding: 0.125rem 0.625rem;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.14);
  }
  .aisle-link {
    margin-inline-start: auto;
    align-self: center;
    white-space: nowrap;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
    display: none;
  }
  .aisle-more {
    margin-top: 0.75rem;
    width: 100%;
    min-height: 2.75rem;
    border-radius: 0.75rem;
    border: 1.5px dashed var(--aw-color-accent);
    color: var(--aw-color-primary);
    font-weight: 700;
    font-size: 0.9375rem;
    background: color-mix(in srgb, var(--aw-color-accent) 8%, transparent);
  }
  :global(.dark) .aisle-more {
    color: #fff;
  }
  .aisle-more:hover {
    background: color-mix(in srgb, var(--aw-color-accent) 16%, transparent);
  }
  .aisle-more:focus-visible,
  .aisle-link:focus-visible {
    outline: 3px solid var(--aw-color-accent);
    outline-offset: 2px;
  }
  .aisle-grid :global([data-extra]:not([hidden])) {
    animation: aisle-in 0.28s ease-out both;
  }
  @keyframes aisle-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .aisle-grid :global([data-extra]:not([hidden])) {
      animation: none;
    }
  }
  @media (min-width: 640px) {
    .aisle-link {
      display: inline;
    }
  }
  @media (min-width: 1024px) {
    /* لوحة القسم عمود رأسي بجانب منتجين، والمكشوف يكمل الشبكة تحتها */
    .aisle-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
    }
    /* على الشاشات الكبيرة تصبح لوحة القسم صورة القسم كاملة بشريط بلون الهوية يحمل الاسم */
    .aisle-sign {
      grid-column: span 2;
      position: relative;
      overflow: hidden;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-end;
      gap: 0.75rem;
      min-height: 22rem;
      padding: 1.75rem;
    }
    .aisle-sign::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, var(--aw-color-primary) 30%, rgb(2 46 79 / 0.55) 55%, transparent 85%);
    }
    .aisle-thumb {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border-radius: 0;
      outline: none;
    }
    .aisle-text,
    .aisle-link {
      position: relative;
      z-index: 1;
    }
    .aisle-link {
      margin-inline-start: 0;
      align-self: flex-start;
    }
  }
</style>
