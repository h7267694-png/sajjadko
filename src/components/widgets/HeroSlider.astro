---
/**
 * سلايدر الرئيسية (2026-10-17). مبني من حزمة المراجعة مع تعديلات لحماية LCP:
 * - الشريحة الأولى وحدها مرئية في HTML، وصورتها eager + fetchpriority=high (عنصر LCP، يكتشفها المتصفح من HTML مباشرة).
 * - الشرائح 2 و3 display:none حتى بعد حدث load بثانيتين، فصورها الكسولة لا تُطلب أثناء التحميل ولا تنافس LCP.
 * - لا مكتبة خارجية، ولا backdrop-filter، ولا حركة على صورة LCP. التبديل التلقائي يحترم تقليل الحركة ويتوقف بالتفاعل.
 * - H1 الصفحة في الشريحة الأولى فقط، والشرائح الأخرى H2. النصوص كلها في HTML.
 * صور الشرائح أعمال حقيقية لسجادكو من src/assets/products (لا صور خارجية).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import WhatsAppButton from '~/components/ui/WhatsAppButton.astro';
import type { WaType } from '~/utils/whatsapp';

import livingRoom from '~/assets/products/sabah-al-salem-living-room-carpet.webp';
import carvedDiwaniya from '~/assets/products/carved-diwaniya-carpet-navy-gold-border.webp';
import mosqueRows from '~/assets/products/mosque-farwaniya-rows.webp';

export interface Props {
  lang: 'ar' | 'en';
  pageName: string;
  eyebrow: string;
  title: string;
  lead: string;
  cta2: string;
  byMeterHref?: string;
  carvingHref?: string;
  mosqueHref?: string;
}

const { lang, pageName, eyebrow, title, lead, cta2, byMeterHref, carvingHref, mosqueHref } = Astro.props;
const ar = lang === 'ar';

type Slide = {
  key: string;
  image: ImageMetadata;
  alt: string;
  eyebrow: string;
  title: string;
  body: string;
  wa: WaType;
  secondaryLabel?: string;
  secondaryHref?: string;
  /** موضع الصورة على الجوال (الصورة طولية والنص أسفلها) */
  pos: string;
};

const slides: Slide[] = [
  {
    key: 'main',
    image: livingRoom,
    alt: ar
      ? 'صالة في صباح السالم مفروشة بموكيت بيج مخملي من الجدار للجدار'
      : 'A living room in Sabah Al-Salem fitted wall to wall with beige plush carpet',
    eyebrow,
    title,
    body: lead,
    wa: 'home',
    secondaryLabel: cta2,
    secondaryHref: byMeterHref,
    pos: '50% 30%',
  },
  {
    key: 'carving',
    image: carvedDiwaniya,
    alt: ar
      ? 'ديوانية مفروشة بموكيت كريمي محفور يدويًا بإطار كحلي وذهبي'
      : 'A diwaniya fitted with cream carpet hand-carved with a navy and gold border',
    eyebrow: ar ? 'حفر يدوي على المقاس' : 'Hand carving to size',
    title: ar ? 'حفر السجاد للديوانيات والمجالس' : 'Hand-carved carpet for diwaniyas and majlis',
    body: ar
      ? 'نحفر النقشة يدويًا في الموكيت والزوالي على مقاس القاعة، ونركّبها من الجدار للجدار.'
      : 'We carve your pattern by hand into carpet and rugs sized to the room, then fit it wall to wall.',
    wa: 'carving',
    secondaryLabel: ar ? 'شاهد أعمال الحفر' : 'See carved work',
    secondaryHref: carvingHref,
    pos: '50% 40%',
  },
  {
    key: 'mosque',
    image: mosqueRows,
    alt: ar
      ? 'صفوف سجاد مسجد أزرق مخضر بنقوش زهور بعد التركيب في الفروانية'
      : 'Teal floral mosque carpet rows after installation in Farwaniya',
    eyebrow: ar ? 'للمساجد والمصليات' : 'Mosques and prayer rooms',
    title: ar ? 'سجاد المساجد بصفوف محاذية للقبلة' : 'Mosque carpet with rows aligned to the qibla',
    body: ar
      ? 'رول بعرض 1.33 م أو 4 م وبثلاث سماكات، نقيس المسجد ونحاذي الصفوف ونركّب.'
      : '1.33 m or 4 m rolls in three thicknesses. We measure, align the rows and install.',
    wa: 'mosque',
    secondaryLabel: ar ? 'سجاد المساجد' : 'Mosque carpet',
    secondaryHref: mosqueHref,
    pos: '50% 55%',
  },
];

// عروض الصورة: الإطار 992×440 حاسوب و(100vw - 32px) للوحي. على الجوال ارتفاع الإطار ثابت 540px والصورة object-fit:cover،
// فعرضها المرسوم = 540 × نسبة الصورة (لا عرض الشاشة)، فنحسب sizes بالبكسل لكل صورة فلا يُحمَّل أكبر من اللازم.
const WIDTHS = [480, 640, 800, 1000, 1280];
const sizesOf = (img: ImageMetadata) =>
  `(min-width: 1056px) 992px, (min-width: 768px) calc(100vw - 32px), ${Math.max(400, Math.round((540 * img.width) / img.height))}px`;
---

<section
  class="hs"
  data-hs
  aria-roledescription={ar ? 'عارض شرائح' : 'carousel'}
  aria-label={ar ? 'خدمات سجادكو' : 'Sajjadko services'}
>
  <div class="hs-frame" data-hs-frame>
    {
      slides.map((s, i) => (
        <div
          class:list={['hs-slide', { 'is-active': i === 0 }]}
          data-hs-slide
          role="group"
          aria-roledescription={ar ? 'شريحة' : 'slide'}
          aria-label={`${i + 1} / ${slides.length}`}
          aria-hidden={i === 0 ? undefined : 'true'}
          inert={i !== 0}
        >
          <Image
            src={s.image}
            alt={s.alt}
            widths={WIDTHS}
            sizes={sizesOf(s.image)}
            quality={50}
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding={i === 0 ? 'sync' : 'async'}
            fetchpriority={i === 0 ? 'high' : 'low'}
            class="hs-img"
            style={`object-position:${s.pos}`}
          />
          <div class="hs-shade" aria-hidden="true" />
          <div class="hs-content">
            <p class="hs-eyebrow">{s.eyebrow}</p>
            {i === 0 ? <h1 class="hs-title">{s.title}</h1> : <h2 class="hs-title">{s.title}</h2>}
            <p class="hs-lead">{s.body}</p>
            <div class="hs-actions">
              <WhatsAppButton type={s.wa} pageName={pageName} position="top" class="hs-wa" />
              {s.secondaryHref && s.secondaryLabel && (
                <a class="hs-sec" href={s.secondaryHref}>
                  {s.secondaryLabel}
                </a>
              )}
            </div>
          </div>
        </div>
      ))
    }

    <a class="hs-lang" href={ar ? '/en/' : '/'} lang={ar ? 'en' : 'ar'} hreflang={ar ? 'en-KW' : 'ar-KW'}>
      {ar ? 'English version' : 'النسخة العربية'}
    </a>

    <div class="hs-ctrl" data-hs-ctrl hidden>
      <button type="button" class="hs-btn" data-hs-prev aria-label={ar ? 'الشريحة السابقة' : 'Previous slide'}>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" class="hs-ico-prev"
          ><path d="m15 6-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
          ></path></svg
        >
      </button>
      <div class="hs-dots">
        {
          slides.map((_, i) => (
            <button
              type="button"
              class:list={['hs-dot', { 'is-active': i === 0 }]}
              data-hs-dot={i}
              aria-label={ar ? `الشريحة ${i + 1}` : `Slide ${i + 1}`}
              aria-current={i === 0 ? 'true' : undefined}
            />
          ))
        }
      </div>
      <button type="button" class="hs-btn" data-hs-next aria-label={ar ? 'الشريحة التالية' : 'Next slide'}>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" class="hs-ico-next"
          ><path d="m9 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
          ></path></svg
        >
      </button>
      <button
        type="button"
        class="hs-btn hs-pause"
        data-hs-toggle
        aria-pressed="false"
        aria-label={ar ? 'إيقاف التبديل التلقائي' : 'Pause slides'}
        data-l-pause={ar ? 'إيقاف التبديل التلقائي' : 'Pause slides'}
        data-l-play={ar ? 'تشغيل التبديل التلقائي' : 'Play slides'}
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="hs-ico-pause"
          ><path d="M8 5v14M16 5v14" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"></path></svg
        >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="hs-ico-play"
          ><path d="M8 5.5v13l10-6.5z" fill="currentColor"></path></svg
        >
      </button>
    </div>
  </div>
</section>

<style>
  .hs-frame {
    position: relative;
    isolation: isolate;
    height: 540px;
    overflow: hidden;
    border-radius: 1.25rem;
    background: var(--brand-navy);
  }
  .hs-slide {
    position: absolute;
    inset: 0;
    display: none;
  }
  .hs-slide.is-active {
    display: block;
    z-index: 1;
  }
  /* الشريحة «المجهزة» (التالية فقط) تدخل الصفحة شفافة قبل ظهورها، فتُطلب صورتها الكسولة قبل التبديل بثوانٍ لا أثناء التحميل */
  [data-ready] .hs-slide.is-armed,
  [data-ready] .hs-slide.is-active {
    display: block;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.6s ease,
      visibility 0.6s;
  }
  [data-ready] .hs-slide.is-active {
    opacity: 1;
    visibility: visible;
  }
  .hs-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hs-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(2 46 79 / 0.1) 0%, rgb(2 46 79 / 0.55) 30%, rgb(2 46 79 / 0.94) 62%);
  }
  .hs-content {
    position: absolute;
    inset: auto 0 0;
    padding: 1.25rem 1.25rem 4.25rem;
    color: #fff;
  }
  .hs-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: rgb(2 46 79 / 0.6);
    border: 1px solid rgb(199 157 88 / 0.7);
    color: #f3dfb8;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .hs-eyebrow::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--brand-gold);
  }
  .hs-title {
    margin: 0 0 0.6rem;
    color: #fff;
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1.35;
    text-wrap: balance;
  }
  .hs-lead {
    margin: 0 0 1rem;
    color: rgb(255 255 255 / 0.92);
    font-size: 0.95rem;
    line-height: 1.8;
  }
  .hs-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .hs :global(.hs-wa) {
    background: var(--brand-gold);
    border-color: var(--brand-gold);
    color: var(--brand-navy);
    font-weight: 800;
    padding: 0.6rem 1.15rem;
  }
  .hs :global(.hs-wa:hover) {
    background: #e2bd80;
    border-color: #e2bd80;
    color: var(--brand-navy);
  }
  .hs-sec {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.6rem 1.15rem;
    border-radius: 999px;
    border: 1.5px solid rgb(255 255 255 / 0.75);
    color: #fff;
    font-weight: 700;
  }
  .hs-sec:hover {
    background: #fff;
    color: var(--brand-navy);
  }
  .hs-lang {
    position: absolute;
    z-index: 3;
    top: 0.85rem;
    inset-inline-end: 0.85rem;
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 0.9rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.92);
    color: var(--brand-navy);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .hs-ctrl {
    position: absolute;
    z-index: 3;
    inset-inline: 1rem;
    bottom: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .hs-ctrl[hidden] {
    display: none;
  }
  .hs-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.5);
    background: rgb(2 46 79 / 0.7);
    color: #fff;
  }
  .hs-btn:hover {
    border-color: var(--brand-gold);
    background: var(--brand-navy);
  }
  [dir='rtl'] .hs-ico-prev,
  [dir='rtl'] .hs-ico-next {
    transform: scaleX(-1);
  }
  .hs-pause {
    margin-inline-start: auto;
  }
  .hs-ico-play,
  .hs-pause[aria-pressed='true'] .hs-ico-pause {
    display: none;
  }
  .hs-pause[aria-pressed='true'] .hs-ico-play {
    display: block;
  }
  .hs-dots {
    display: flex;
    align-items: center;
  }
  /* هدف لمس 24px مع نقطة مرئية صغيرة */
  .hs-dot {
    position: relative;
    width: 1.5rem;
    height: 1.5rem;
  }
  .hs-dot::before {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.7);
    transform: translate(-50%, -50%);
    transition: width 0.2s;
  }
  .hs-dot.is-active::before {
    width: 1.4rem;
    background: var(--brand-gold);
  }
  .hs-btn:focus-visible,
  .hs-dot:focus-visible,
  .hs-lang:focus-visible,
  .hs-sec:focus-visible {
    outline: 3px solid var(--brand-gold);
    outline-offset: 2px;
  }
  @media (min-width: 768px) {
    .hs-frame {
      height: 440px;
    }
    .hs-shade {
      background: linear-gradient(
        to var(--hs-to, right),
        rgb(2 46 79 / 0.92) 0%,
        rgb(2 46 79 / 0.72) 36%,
        rgb(2 46 79 / 0) 66%
      );
    }
    .hs-content {
      top: 0;
      inset-inline-end: auto;
      width: min(100%, 36rem);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      padding: 2.5rem 3rem 4rem;
    }
    .hs-title {
      font-size: 2.6rem;
    }
    .hs-lead {
      font-size: 1.05rem;
    }
    .hs-ctrl {
      inset-inline: auto 1.25rem;
    }
    .hs-pause {
      margin-inline-start: 0.4rem;
    }
  }
  [dir='rtl'] .hs-shade {
    --hs-to: left;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-ready] .hs-slide {
      transition: none;
    }
  }
</style>

<script is:inline>
  (function () {
    const root = document.querySelector('[data-hs]');
    if (!root || root.dataset.init) return;
    root.dataset.init = '1';
    const slides = root.querySelectorAll('[data-hs-slide]');
    const dots = root.querySelectorAll('[data-hs-dot]');
    const toggle = root.querySelector('[data-hs-toggle]');
    const ctrl = root.querySelector('[data-hs-ctrl]');
    if (slides.length < 2) return;
    const rm = window.matchMedia('(prefers-reduced-motion: reduce)');
    let i = 0,
      timer = 0,
      paused = rm.matches,
      hold = false,
      x0 = null;
    function arm(n) {
      slides[(n + slides.length) % slides.length].classList.add('is-armed');
    }
    function show(n) {
      i = (n + slides.length) % slides.length;
      arm(i);
      arm(i + 1);
      slides.forEach(function (s, k) {
        const on = k === i;
        s.classList.toggle('is-active', on);
        s.inert = !on;
        if (on) s.removeAttribute('aria-hidden');
        else s.setAttribute('aria-hidden', 'true');
      });
      dots.forEach(function (d, k) {
        d.classList.toggle('is-active', k === i);
        if (k === i) d.setAttribute('aria-current', 'true');
        else d.removeAttribute('aria-current');
      });
    }
    function stop() {
      clearInterval(timer);
      timer = 0;
    }
    function run() {
      stop();
      toggle.setAttribute('aria-pressed', String(paused));
      toggle.setAttribute('aria-label', paused ? toggle.dataset.lPlay : toggle.dataset.lPause);
      if (!paused && !hold && !document.hidden)
        timer = setInterval(function () {
          show(i + 1);
        }, 6500);
    }
    function go(n) {
      show(n);
      run();
    }
    // بعد load بثانيتين: تظهر الأدوات وتُجهَّز الشريحة التالية فقط (صورتها الكسولة تُطلب بعد اكتمال الصفحة لا قبلها)
    function ready() {
      setTimeout(function () {
        root.setAttribute('data-ready', '');
        arm(1);
        ctrl.hidden = false;
        run();
      }, 2000);
    }
    if (document.readyState === 'complete') ready();
    else window.addEventListener('load', ready, { once: true });
    root.querySelector('[data-hs-prev]').addEventListener('click', function () {
      go(i - 1);
    });
    root.querySelector('[data-hs-next]').addEventListener('click', function () {
      go(i + 1);
    });
    dots.forEach(function (d) {
      d.addEventListener('click', function () {
        go(+d.dataset.hsDot);
      });
    });
    toggle.addEventListener('click', function () {
      paused = !paused;
      run();
    });
    root.addEventListener('mouseenter', function () {
      hold = true;
      stop();
    });
    root.addEventListener('mouseleave', function () {
      hold = false;
      run();
    });
    root.addEventListener('focusin', function () {
      hold = true;
      stop();
    });
    root.addEventListener('focusout', function (e) {
      if (!root.contains(e.relatedTarget)) {
        hold = false;
        run();
      }
    });
    document.addEventListener('visibilitychange', run);
    const frame = root.querySelector('[data-hs-frame]');
    frame.addEventListener(
      'touchstart',
      function (e) {
        x0 = e.touches[0].clientX;
      },
      { passive: true }
    );
    frame.addEventListener(
      'touchend',
      function (e) {
        if (x0 === null || !root.hasAttribute('data-ready')) return;
        const dx = e.changedTouches[0].clientX - x0;
        x0 = null;
        if (Math.abs(dx) > 45) {
          const rtl = document.documentElement.dir === 'rtl';
          go(i + (dx < 0 !== rtl ? 1 : -1));
        }
      },
      { passive: true }
    );
  })();
</script>
