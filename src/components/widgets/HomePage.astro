// الأقسام: تظهر بطاقة لكل خدمة، والرابط فقط إن نُشرت صفحتها
const offers: { key: string; t: string; d: string }[] = ar
  ? [
      {
        key: 'by-meter',
        t: 'سجاد وموكيت بالمتر',
        d: 'سجاد تركي وموكيت من 5 إلى 15 د.ك للمتر المربع، يُقص على المقاس.',
      },
      { key: 'hallway', t: 'سجاد الممرات والمدات', d: 'مدات تُقص بطول ممرك، ومدات السدو، بنقشات وألوان متعددة.' },
      { key: 'mosque-carpets', t: 'سجاد المساجد', d: 'رول 1.33 م أو 4 م، صفوف محاذية للقبلة، بثلاث سماكات.' },
      { key: 'musalla', t: 'سجاد المصليات', d: 'مصليات الشركات والمدارس والمجمعات، والمصلى المتنقل.' },
      { key: 'carpet-cutting', t: 'قص السجاد', d: 'قص السجاد والموكيت على المقاس حول الأعمدة والمداخل.' },
      { key: 'carpet-installation', t: 'تركيب السجاد والموكيت', d: 'تركيب ما نوفره، مع متابعة يومين بعد التركيب.' },
      { key: 'hand-carving', t: 'حفر السجاد', d: 'حفر النقشة يدويًا في السجاد والزوالي حسب الطلب.' },
      { key: 'red-carpet', t: 'ريد كاربت للمناسبات', d: 'بيع وتأجير للأعراس والمناسبات، التأجير شامل التركيب والفك.' },
    ]
  : [
      {
        key: 'by-meter',
        t: 'Carpet by the metre',
        d: 'Turkish carpet and wall-to-wall carpet, 5 to 15 KWD per m², cut to size.',
      },
      {
        key: 'hallway',
        t: 'Hallway runners',
        d: 'Runners cut to your hallway length, plus Sadu runners, in many designs.',
      },
      {
        key: 'mosque-carpets',
        t: 'Mosque carpet',
        d: '1.33 m or 4 m rolls, rows aligned with the qibla, three thicknesses.',
      },
      {
        key: 'musalla',
        t: 'Prayer room carpet',
        d: 'Prayer rooms for companies, schools and malls, plus mobile musallas.',
      },
      { key: 'carpet-cutting', t: 'Carpet cutting', d: 'Carpet cut to size around columns and doorways.' },
      {
        key: 'carpet-installation',
        t: 'Carpet installation',
        d: 'We install what we supply, with a two-day follow-up.',
      },
      { key: 'hand-carving', t: 'Hand-carved rugs', d: 'Your pattern carved by hand into carpet and rugs.' },
      {
        key: 'red-carpet',
        t: 'Red carpet for events',
        d: 'Sale and rental for weddings and events, rental includes laying and removal.',
