    ];
const byMeter = linkOf('by-meter');
// تسوق حسب القسم: الأقسام المنشورة فقط بصورة منتج منها. والباقي يظهر نصًا في «خدمات أخرى» بلا رابط مكسور
const tiles = offers.flatMap((o) => {
  const href = linkOf(o.key);
  return href ? [{ key: o.key, t: o.t, href, img: o.img }] : [];
});
const otherServices = offers.filter((o) => !linkOf(o.key));
const projectsHref = ar ? '/projects/' : '/en/projects/';
const TRUST_ICONS = [
  'tabler:home-check',
  'tabler:building-store',
  'tabler:receipt-2',
  'tabler:ruler-measure',
  'tabler:tool',
];
const WHY_ICONS = [
  'tabler:home-check',
  'tabler:building-store',
  'tabler:receipt-2',
  'tabler:scissors',
  'tabler:tool',
  'tabler:language',
  'tabler:brand-whatsapp',
];
---

<PageLayout
  pageType="home"
  pageName={ar ? 'الرئيسية' : 'Home'}
  alternates={{ ar: '/', en: '/en/' }}
  metadata={{ title: c.title, ignoreTitleTemplate: true, description: c.desc }}
>
  <StructuredData slot="head" schema={schema} />

  <OfferSlider
    lang={lang}
    pageName={ar ? 'الرئيسية' : 'Home'}
    links={{
      offices: linkOf('offices'),
      'mosque-carpets': linkOf('mosque-carpets'),
      'red-carpet': linkOf('red-carpet'),
      'carpet-tiles': linkOf('carpet-tiles'),
    }}
  />
  <div class="mx-auto max-w-5xl px-4">
    <section class="home-intro">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
        <p class="text-sm font-semibold text-accent">{c.eyebrow}</p>
        <a
          href={ar ? '/en/' : '/'}
          lang={ar ? 'en' : 'ar'}
          hreflang={ar ? 'en-KW' : 'ar-KW'}
          class="inline-flex items-center min-h-10 px-3.5 rounded-full border-2 border-primary text-primary dark:text-white text-sm font-bold hover:bg-primary hover:text-white"
        >
          {ar ? 'English version' : 'النسخة العربية'}
        </a>
      </div>
      <h1 class="text-2xl md:text-4xl font-extrabold leading-snug mb-2 max-w-3xl">{c.h1}</h1>
      <p class="text-base md:text-lg text-muted max-w-3xl mb-4">{c.lead}</p>
      <div class="flex flex-wrap gap-2.5">
        <WhatsAppButton type="home" pageName={ar ? 'الرئيسية' : 'Home'} position="top" />
        {
          byMeter && (
            <a href={byMeter} class="btn-secondary inline-flex items-center min-h-11">
              {c.cta2}
            </a>
          )
        }
      </div>
    </section>
    <ul class="trust-strip" aria-label={ar ? 'مميزات سجادكو' : 'Why customers choose us'}>
      {
        c.trust.map((x, i) => (
          <li>
            <span class="trust-ico" aria-hidden="true">
              <Icon name={TRUST_ICONS[i] ?? 'tabler:check'} />
            </span>
            <span>{x}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="mx-auto max-w-5xl px-4">
    <HomeStore lang={lang} pageName={ar ? 'الرئيسية' : 'Home'} tiles={tiles} />
    {
      byMeter && (
        <p class="-mt-4 mb-10">
          <a href={byMeter} class="font-semibold text-primary dark:text-white hover:underline">
            {c.allProducts} {ar ? '←' : '→'}
          </a>
        </p>
      )
    }

    <div class="max-w-3xl">
      <AnswerBox answer={c.answer} label={c.short} />
      <FreeVisit pageName={ar ? 'الرئيسية' : 'Home'} />
    </div>

    {
      otherServices.length > 0 && (
        <section class="my-12" aria-labelledby="offer">
          <h2 id="offer" class="sec-title">
            {c.offerTitle}
          </h2>
          <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {otherServices.map((o) => (
              <li class="svc-card">
                <h3 class="font-semibold mb-1">{o.t}</h3>
                <p class="text-sm text-muted">{o.d}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="my-12" aria-labelledby="prices">
      <h2 id="prices" class="sec-title">{c.pricesTitle}</h2>
      <div class="price-wrap">
        <table class="price-table">
          <thead>
            <tr>
              {c.priceHead.map((h) => <th scope="col">{h}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              c.prices.map((r) => (
                <tr>
                  <th scope="row">{r[0]}</th>
                  <td class="price-val">{r[1]}</td>
                  <td class="text-muted">{r[2]}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="text-xs text-muted mt-2">
        {c.priceNote}: <time datetime="2026-10-07"><bdi dir="ltr">2026-10-07</bdi></time>
      </p>
    </section>

    <section class="my-12" aria-labelledby="steps">
      <h2 id="steps" class="sec-title">{c.stepsTitle}</h2>
      <ol class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          c.steps.map((s, i) => (
            <li class="step-card">
              <span class="step-num" aria-hidden="true">
                {i + 1}
              </span>
              {s}
            </li>
          ))
        }
      </ol>
      <div class="mt-6"><WhatsAppButton type="home" pageName={ar ? 'الرئيسية' : 'Home'} position="mid" /></div>
    </section>

    <section class="my-12" aria-labelledby="why">
      <h2 id="why" class="sec-title">{c.whyTitle}</h2>
      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          c.why.map(([h, d], i) => (
            <li class="why-card">
              <span class="why-ico" aria-hidden="true">
                <Icon name={WHY_ICONS[i] ?? 'tabler:check'} />
              </span>
              <h3 class="font-bold mb-1">{h}</h3>
              <p class="text-sm text-muted">{d}</p>
            </li>
          ))
        }
      </ul>
    </section>

    {
      hasWorks && (
        <section class="works-band" aria-labelledby="works">
          <h2 id="works" class="text-2xl md:text-3xl font-extrabold mb-2">
            {c.worksTitle}
          </h2>
          <p class="mb-3">{c.worksText}</p>
          <a href={projectsHref} class="works-link">
            {c.worksLink} {ar ? '←' : '→'}
          </a>
        </section>
      )
    }

    <div class="max-w-3xl"><FaqList items={c.faq} title={c.faqTitle} /></div>

    <section class="my-12" aria-labelledby="visit">
      <h2 id="visit" class="sec-title">{c.visitTitle}</h2>
      <p class="mb-3 max-w-3xl">{c.visitText}</p>
      {
        settings && (
          <address class="not-italic space-y-1 text-muted">
            {settings.address?.[lang] && <p>{settings.address[lang]}</p>}
            {settings.hours?.[lang] && <p>{settings.hours[lang]}</p>}
            {settings.whatsapp && (
              <p>
                <bdi dir="ltr">{formatPhone(settings.whatsapp)}</bdi>
              </p>
            )}
          </address>
        )
      }
      <div class="mt-6"><WhatsAppButton type="home" pageName={ar ? 'الرئيسية' : 'Home'} position="end" /></div>
    </section>
  </div>
</PageLayout>

<style>
  .home-intro {
    padding-top: 1.1rem;
  }
  /* شريط المميزات: صف أفقي يُسحب على الجوال، وخمسة أعمدة على الحاسوب */
  .trust-strip {
    display: flex;
    gap: 0.5rem;
    margin: 0.75rem -0.5rem 0;
    padding: 0 0.5rem 0.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .trust-strip li {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.8rem 0.45rem 0.6rem;
    border-radius: 999px;
    background: var(--brand-sand);
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.4;
    white-space: nowrap;
    scroll-snap-align: start;
  }
  @media (min-width: 1024px) {
    .trust-strip {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      margin-inline: 0;
      padding: 0;
      overflow: visible;
    }
    .trust-strip li {
      border-radius: 0.875rem;
      white-space: normal;
    }
  }
  .trust-ico,
  .why-ico {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    background: var(--brand-navy);
    color: var(--brand-gold);
  }
  .trust-ico {
    width: 1.85rem;
    height: 1.85rem;
  }
  .trust-ico :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
  }
  .svc-card {
    padding: 1rem;
    border-radius: 1rem;
    border: 1px solid var(--brand-line);
    border-top: 3px solid var(--brand-gold);
    background: var(--aw-color-bg-page);
  }
  .price-wrap {
    overflow-x: auto;
    border-radius: 1rem;
    border: 1px solid var(--brand-line);
  }
  .price-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    text-align: start;
  }
  .price-table th,
  .price-table td {
    padding: 0.7rem 0.9rem;
    text-align: start;
    vertical-align: top;
  }
  .price-table thead th {
    background: var(--brand-navy);
    color: #fff;
    font-weight: 700;
  }
  .price-table tbody tr:nth-child(even) {
    background: var(--brand-sand);
  }
  .price-table tbody th {
    font-weight: 600;
  }
  .price-val {
    font-weight: 700;
    color: var(--aw-color-text-heading);
  }
  .step-card {
    position: relative;
    padding: 1rem;
    border-radius: 1rem;
    background: var(--brand-sand);
  }
  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-bottom: 0.5rem;
    border-radius: 50%;
    background: var(--brand-gold);
    color: var(--brand-navy);
    font-weight: 800;
  }
  .why-card {
    padding: 1rem;
    border-radius: 1rem;
    border: 1px solid var(--brand-line);
  }
  .why-ico {
    width: 2.6rem;
    height: 2.6rem;
    margin-bottom: 0.6rem;
  }
  .why-ico :global(svg) {
    width: 1.35rem;
    height: 1.35rem;
  }
  .works-band {
    margin-block: 3rem;
    padding: 1.5rem;
    border-radius: 1.25rem;
    background: var(--brand-navy);
    color: #fff;
    border-inline-start: 6px solid var(--brand-gold);
  }
  .works-band h2 {
    color: #fff;
  }
  .works-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-top: 0.25rem;
    padding: 0.5rem 1.15rem;
    border-radius: 999px;
    background: var(--brand-gold);
    color: var(--brand-navy);
    font-weight: 800;
  }
  @media (min-width: 768px) {
    .price-table {
      font-size: 1rem;
    }
  }
</style>
