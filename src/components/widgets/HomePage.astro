const byMeter = linkOf('by-meter');
const projectsHref = ar ? '/ar/projects/' : '/projects/';
---

<PageLayout
  pageType="home"
  pageName={ar ? 'الرئيسية' : 'Home'}
  alternates={{ en: '/', ar: '/ar/' }}
  metadata={{ title: c.title, ignoreTitleTemplate: true, description: c.desc }}
>
  <StructuredData slot="head" schema={schema} />

  <section class="bg-primary/5 dark:bg-slate-800/40">
    <div class="mx-auto max-w-5xl px-4 pt-6 pb-5 md:pt-14 md:pb-10">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
        <p class="text-sm font-semibold text-accent">{c.eyebrow}</p>
        <a
          href={ar ? '/' : '/ar/'}
          lang={ar ? 'en' : 'ar'}
          hreflang={ar ? 'en-KW' : 'ar-KW'}
          class="inline-flex items-center gap-2 min-h-11 px-4 rounded-full bg-white dark:bg-slate-900 border-2 border-primary text-primary dark:text-white font-bold shadow-sm hover:bg-primary hover:text-white"
        >
          {ar ? 'English version' : 'النسخة العربية'}
        </a>
      </div>
      <h1 class="text-3xl md:text-5xl font-bold leading-tight mb-4 max-w-3xl">{c.h1}</h1>
      <p class="text-lg md:text-xl text-muted max-w-2xl mb-6">{c.lead}</p>
      <div class="flex flex-wrap gap-3">
        <WhatsAppButton type="home" pageName={ar ? 'الرئيسية' : 'Home'} position="top" />
        {
          byMeter && (
            <a href={byMeter} class="btn-secondary inline-flex items-center min-h-11">
              {c.cta2}
            </a>
          )
        }
      </div>
      <ul class="mt-5 hidden md:flex flex-wrap gap-x-5 gap-y-1.5 max-w-3xl text-sm">
        {
          c.trust.map((x) => (
            <li class="flex items-start gap-2">
              <span aria-hidden="true" class="text-accent">
                ✓
              </span>
              {x}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <div class="mx-auto max-w-5xl px-4">
    <ProductGrid pageName={ar ? 'الرئيسية' : 'Home'} limit={8} title={c.products} compact carousel />
    {
      byMeter && (
        <p class="mt-1 mb-10">
          <a href={byMeter} class="font-semibold text-primary dark:text-white hover:underline">
            {c.allProducts} {ar ? '←' : '→'}
          </a>
        </p>
      )
    }

    <ul class="md:hidden -mt-4 mb-8 grid gap-1.5 text-sm">
      {
        c.trust.map((x) => (
          <li class="flex items-start gap-2">
            <span aria-hidden="true" class="text-accent">
              ✓
            </span>
            {x}
          </li>
        ))
      }
    </ul>
    <div class="max-w-3xl"><AnswerBox answer={c.answer} label={c.short} /></div>

    <section class="my-12" aria-labelledby="offer">
      <h2 id="offer" class="text-2xl md:text-3xl font-bold mb-6">{c.offerTitle}</h2>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          offers.map((o) => {
            const href = linkOf(o.key);
            return (
              <li class="rounded-lg border border-gray-200 dark:border-slate-700 p-4">
                <h3 class="font-semibold mb-1">
                  {href ? (
                    <a href={href} class="hover:underline text-primary dark:text-white">
                      {o.t}
                    </a>
                  ) : (
                    o.t
                  )}
                </h3>
                <p class="text-sm text-muted">{o.d}</p>
              </li>
            );
          })
        }
      </ul>
    </section>

    <section class="my-12" aria-labelledby="prices">
      <h2 id="prices" class="text-2xl md:text-3xl font-bold mb-4">{c.pricesTitle}</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-start text-sm md:text-base border-collapse">
          <thead>
            <tr class="border-b-2 border-primary">
              {
                c.priceHead.map((h) => (
                  <th scope="col" class="py-2 pe-4 text-start font-semibold">
                    {h}
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              c.prices.map((r) => (
                <tr class="border-b border-gray-200 dark:border-slate-700">
                  <th scope="row" class="py-2 pe-4 text-start font-medium">
                    {r[0]}
                  </th>
                  <td class="py-2 pe-4">{r[1]}</td>
                  <td class="py-2 pe-4 text-muted">{r[2]}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="text-xs text-muted mt-2">
        {c.priceNote}: <time datetime="2026-10-07"><bdi dir="ltr">2026-10-07</bdi></time>
      </p>
    </section>

    <section class="my-12" aria-labelledby="steps">
      <h2 id="steps" class="text-2xl md:text-3xl font-bold mb-4">{c.stepsTitle}</h2>
      <ol class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          c.steps.map((s, i) => (
            <li class="rounded-lg bg-primary/5 dark:bg-slate-800 p-4">
              <span class="block text-2xl font-bold text-accent mb-1">{i + 1}</span>
              {s}
            </li>
          ))
        }
      </ol>
      <div class="mt-6"><WhatsAppButton type="home" pageName={ar ? 'الرئيسية' : 'Home'} position="mid" /></div>
    </section>

    <section class="my-12" aria-labelledby="why">
      <h2 id="why" class="text-2xl md:text-3xl font-bold mb-6">{c.whyTitle}</h2>
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          c.why.map(([h, d]) => (
            <li>
              <h3 class="font-semibold mb-1">{h}</h3>
              <p class="text-sm text-muted">{d}</p>
            </li>
          ))
        }
      </ul>
    </section>

    {
      hasWorks && (
        <section class="my-12 rounded-lg border border-accent/40 bg-accent/5 p-6" aria-labelledby="works">
          <h2 id="works" class="text-2xl font-bold mb-2">
            {c.worksTitle}
          </h2>
          <p class="mb-3">{c.worksText}</p>
          <a href={projectsHref} class="font-semibold text-primary dark:text-white hover:underline">
            {c.worksLink} {ar ? '←' : '→'}
          </a>
        </section>
      )
    }

    <div class="max-w-3xl"><FaqList items={c.faq} title={c.faqTitle} /></div>

    <section class="my-12" aria-labelledby="visit">
      <h2 id="visit" class="text-2xl md:text-3xl font-bold mb-3">{c.visitTitle}</h2>
      <p class="mb-3 max-w-3xl">{c.visitText}</p>
      {
        settings && (
          <address class="not-italic space-y-1 text-muted">
            {settings.address?.[lang] && <p>{settings.address[lang]}</p>}
            {settings.hours?.[lang] && <p>{settings.hours[lang]}</p>}
            {settings.whatsapp && (
              <p>
                <bdi dir="ltr">{formatPhone(settings.whatsapp)}</bdi>
              </p>
            )}
          </address>
        )
      }
      <div class="mt-6"><WhatsAppButton type="home" pageName={ar ? 'الرئيسية' : 'Home'} position="end" /></div>
    </section>
  </div>
</PageLayout>
