---
// الصفحة الرئيسية (20.14 و16.2 و24.4). عنصر LCP نصي (العنوان والسطر التوضيحي)، بلا صورة بطل.
// العربية: العلامة + «سجاد وموكيت» (لا تنافس صفحة «سجاد الكويت»). الإنجليزية: carpet kuwait و rugs kuwait.
// روابط الخدمات والأقسام تظهر تلقائيًا فقط للصفحات المنشورة، فلا رابط مكسور قبل نشرها.
import { getCollection } from 'astro:content';
import PageLayout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import AnswerBox from '~/components/ui/AnswerBox.astro';
import FaqList from '~/components/ui/FaqList.astro';
import WhatsAppButton from '~/components/ui/WhatsAppButton.astro';
import ProductGrid from '~/components/widgets/ProductGrid.astro';
import { getSettings, toLocale, formatPhone } from '~/utils/site';
import { buildHomeSchema } from '~/utils/schema';
import { pageHref } from '~/utils/pages';
import { getLatestWorks } from '~/utils/products';

const lang = toLocale(Astro.currentLocale);
const ar = lang === 'ar';
const settings = await getSettings();
const schema = settings ? buildHomeSchema(settings, lang, Astro.site!) : [];

const published = (await getCollection('pages')).filter((p) => p.data.status === 'published' && p.data.lang === lang);
const linkOf = (key: string) => {
  const p = published.find((x) => x.data.translationKey === key);
  return p ? pageHref(lang, p.data.urlPath) : undefined;
};
const hasWorks = (await getLatestWorks(lang)).length > 0;

const c = ar
  ? {
      title: 'سجاد وموكيت في الكويت، قص وتركيب على المقاس — سجادكو الكويت',
      desc: 'سجادكو الكويت في الضجيج: سجاد تركي وموكيت ومدات ممرات وسجاد مساجد بالمتر، قص وتركيب على المقاس من 5 إلى 15 د.ك للمتر المربع. اطلب عبر واتساب.',
      eyebrow: 'سجادكو الكويت · الضجيج',
      h1: 'سجاد وموكيت في الكويت، قص وتركيب على المقاس',
      lead: 'توريد وقص وحفر وتركيب السجاد والموكيت للبيوت والمساجد والمكاتب والمشاريع. اختر الخامة واللون، وأرسل مقاس مكانك، ونقص ونركّب.',
      cta2: 'تصفح السجاد بالمتر',
      trust: [
        'محل في الضجيج تزوره وترى الخامات',
        'سعر بالمتر المربع من 5 إلى 15 د.ك',
        'قص على مقاس مكانك بالضبط',
        'تركيب ومتابعة يومين بعده',
      ],
      short: 'الإجابة باختصار',
      answer:
        'سجادكو الكويت محل سجاد وموكيت في الضجيج يبيع السجاد التركي والموكيت ومدات الممرات وسجاد المساجد بالمتر المربع، ويقصها على مقاس المكان ويركّبها. السعر من 5 إلى 15 د.ك للمتر المربع حسب السماكة والكثافة، وسجاد المساجد 6 أو 7 أو 8 د.ك. الطلب عبر واتساب: أرسل المقاس والمنطقة ونؤكد لك الخيارات والسعر.',
      offerTitle: 'ماذا نقدم',
      products: 'من منتجاتنا',
      allProducts: 'كل المنتجات والألوان',
      pricesTitle: 'الأسعار باختصار',
      priceHead: ['الخدمة أو المنتج', 'السعر', 'الوحدة'],
      prices: [
        ['السجاد التركي والموكيت', 'من 5 إلى 15 د.ك', 'للمتر المربع'],
        ['سجاد المساجد والمصليات', '6 / 7 / 8 د.ك (خفيف / وسط / سميك)', 'للمتر المربع'],
        ['تأجير الريد كاربت', '1 د.ك خارجي، 0.750 د.ك داخلي', 'للمتر المربع، شامل التوصيل والتركيب والفك'],
        ['التركيب', 'يُتفق حسب المساحة والموقع', 'منفصل عن سعر السجاد'],
      ],
      priceNote: 'آخر تحديث للأسعار',
      stepsTitle: 'كيف تطلب',
      steps: [
        'قس طول المكان وعرضه بالمتر.',
        'أرسل المقاس والمنطقة ونوع المكان عبر واتساب.',
        'اختر الخامة واللون، ونؤكد لك السعر.',
        'نقص ونركّب، ثم نتابع معك يومين.',
      ],
      whyTitle: 'لماذا سجادكو الكويت',
      why: [
        ['محل حقيقي في الضجيج', 'ترى الخامات وتلمسها قبل الطلب، في مجمع علي عبدالوهاب.'],
        ['سعر واضح بالمتر', 'نعلن نطاق السعر لكل نوع، وتعرف الكلفة بضرب المساحة في سعر المتر.'],
        ['قص على المقاس', 'لا يقيدك مقاس جاهز. نراجع المقاس معك قبل القص لأن القص لا يُعاد.'],
        ['تركيب ومتابعة', 'نركّب ما نوفره، ونتابع معك يومين بعد التركيب لمعالجة أي خطأ.'],
        ['عربي وإنجليزي', 'نخدم العائلات والشركات والمقيمين بالعربية والإنجليزية.'],
        ['واتساب مباشر', 'لا حسابات ولا دفع إلكتروني: رسالة واحدة وتصلك الخيارات.'],
      ],
      worksTitle: 'من أعمالنا الأخيرة',
      worksText: 'أعمال نفذناها مؤخرًا في مناطق الكويت، مع المنطقة والخامة المستخدمة.',
      worksLink: 'شاهد أعمالنا الأخيرة',
      visitTitle: 'زرنا في الضجيج',
      visitText: 'نخدم مناطق الكويت كلها من محلنا في الضجيج. تعال لترى الخامات، أو أرسل المقاس عبر واتساب.',
      faqTitle: 'أسئلة شائعة',
      faq: [
        {
          q: 'ماذا تبيع سجادكو الكويت؟',
          a: 'نبيع السجاد التركي والموكيت ومدات الممرات وسجاد المساجد والمصليات بالمتر المربع، ونقصها على مقاس المكان ونركّبها. ونؤجر الريد كاربت للمناسبات، ونحفر السجاد حسب النقشة. لا نبيع السجاد الإيراني ولا سجادة الصلاة الفردية ولا الدعاسات.',
        },
        {
          q: 'أين يقع محلكم؟',
          a: 'محلنا في الكويت، الضجيج، مجمع علي عبدالوهاب، السرداب، مخزن رقم 3، ونعمل من 8 صباحًا حتى 8 مساءً. يمكنك زيارتنا لترى الخامات، أو إرسال المقاس عبر واتساب ونرد عليك بالخيارات والسعر.',
