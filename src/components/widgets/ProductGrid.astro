---
// شبكة النماذج (6.1 بند 5): بطاقة لكل منتج (الصورة، الاسم، الألوان، طريقة البيع) وزر واتساب باسم المنتج.
// تعرض المنشور فقط، والمسودات في التطوير. ItemList في JSON-LD من النص الظاهر نفسه.
import { Image } from 'astro:assets';
import { getSettings, toLocale } from '~/utils/site';
import { getProducts, productHref } from '~/utils/products';

export interface Props {
  categories?: string[];
  places?: string[];
  services?: string[];
  pageName: string;
  /** حد أقصى للبطاقات (الرئيسية) */
  limit?: number;
  title?: string;
  /** بطاقة مختصرة: بلا وصف ولا ألوان (الرئيسية) */
  compact?: boolean;
  /** شريط أفقي بتمرير سلس (الرئيسية) بدل الشبكة */
  carousel?: boolean;
  /** عدد الصور الأولى التي تُحمَّل فورًا (الباقي كسول) */
  eager?: number;
}

const { categories, places, services, pageName, limit, title, compact = false, carousel = false, eager = 0 } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const settings = await getSettings();

const sorted = (await getProducts(locale))
  .filter((p) => !categories?.length || categories.includes(p.data.category))
  .filter((p) => !places?.length || p.data.places.some((x) => places.includes(x)))
  .filter((p) => !services?.length || (p.data.services ?? []).some((x) => services.includes(x)))
  .sort((a, b) => a.data.sku.localeCompare(b.data.sku));

// مع حد أقصى: تناوب بين الأنواع حتى تظهر عينة من كل نوع (الرئيسية)
const items = limit
  ? (() => {
      const groups = [...new Set(sorted.map((p) => p.data.category))].map((c) =>
        sorted.filter((p) => p.data.category === c)
      );
      const out: typeof sorted = [];
      for (let i = 0; out.length < Math.min(limit, sorted.length); i++)
        for (const g of groups) if (g[i] && out.length < limit) out.push(g[i]);
      return out;
    })()
  : sorted;

const t =
  locale === 'ar'
    ? {
        title: 'النماذج والألوان المتوفرة',
        colors: 'الألوان',
        ask: 'اسأل عن هذا الموكيت',
        code: 'رمز اللون',
        size: 'المقاس',
      }
    : {
        title: 'Available collections and colours',
        colors: 'Colours',
        ask: 'Ask about this carpet',
        code: 'Colour code',
        size: 'Size',
      };

const colorLabel = (c: string) => {
  const [code, rest = ''] = c.split(/ (.+)/);
  const [ar, en] = rest.split(' / ');
  return { code, name: (locale === 'ar' ? ar : en) ?? rest };
};

const waHref = (name: string) => {
  if (!settings?.whatsapp) return null;
  const msg =
    locale === 'ar'
      ? `مرحبًا، أرغب بالاستفسار عن ${name}. ${t.code}: [الرمز]. ${t.size}: [الطول × العرض]. (من صفحة: ${pageName})`
      : `Hello, I would like to ask about ${name}. ${t.code}: [code]. ${t.size}: [length × width]. (From page: ${pageName})`;
  return `https://wa.me/${settings.whatsapp}?text=${encodeURIComponent(msg)}`;
};

const schema = items.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: t.title,
      itemListElement: items.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: p.data[locale]!.name,
        url: new URL(productHref(locale, p.id), Astro.site).href,
      })),
    }
  : null;

// أزرار السابق/التالي للشريط (سطر واحد، بلا مكتبة). التمرير باللمس لا يحتاج أي JS.
const NAV_JS = `document.querySelectorAll('[data-carousel-nav]').forEach(function(n){var u=n.closest('section').querySelector('[data-carousel]');n.addEventListener('click',function(e){var b=e.target.closest('button');if(!b)return;var d=+b.dataset.dir*(document.dir==='rtl'?-1:1);u.scrollBy({left:d*u.clientWidth*0.8,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'});});});`;
---

{
  items.length > 0 && (
    <section class:list={['not-prose', carousel ? 'mt-6 mb-4' : 'my-10']} aria-labelledby="product-grid-title">
      <div class="flex items-end justify-between gap-4 mb-4">
        <h2 id="product-grid-title" class="text-2xl font-bold">
          {title ?? t.title}
        </h2>
        {carousel && (
          <div class="hidden md:flex gap-2" data-carousel-nav>
            <button
              type="button"
              data-dir="-1"
              class="carousel-btn"
              aria-label={locale === 'ar' ? 'السابق' : 'Previous'}
            >
              <span aria-hidden="true">{locale === 'ar' ? '→' : '←'}</span>
            </button>
            <button type="button" data-dir="1" class="carousel-btn" aria-label={locale === 'ar' ? 'التالي' : 'Next'}>
              <span aria-hidden="true">{locale === 'ar' ? '←' : '→'}</span>
            </button>
          </div>
        )}
      </div>
      <ul
        class:list={[
          carousel
            ? 'carousel flex gap-4 overflow-x-auto snap-x snap-mandatory motion-safe:scroll-smooth pb-4 -mx-4 px-4'
            : 'grid gap-6 sm:grid-cols-2',
        ]}
        data-carousel={carousel ? '' : undefined}
      >
        {items.map((p, i) => {
          const tx = p.data[locale]!;
          const img = p.data.images[0];
          const href = waHref(tx.name);
          return (
            <li
              class:list={[
                'rounded-lg border border-gray-200 dark:border-slate-700 overflow-hidden flex flex-col bg-white dark:bg-slate-900',
                carousel &&
                  'snap-start shrink-0 w-[78%] sm:w-[46%] lg:w-[31%] xl:w-[23.5%] transition-transform motion-safe:hover:-translate-y-1',
              ]}
            >
              {img && (
                <Image
                  src={img.src}
                  alt={img.alt[locale] ?? ''}
                  widths={carousel ? [320, 480] : [360, 640]}
                  sizes={
                    carousel
                      ? '(min-width: 1280px) 280px, (min-width: 1024px) 31vw, (min-width: 640px) 46vw, 78vw'
                      : '(min-width: 640px) 360px, 100vw'
                  }
                  loading={i < eager ? 'eager' : 'lazy'}
                  decoding="async"
                  fetchpriority={carousel ? 'low' : undefined}
                  class:list={[
                    'w-full aspect-[4/3] bg-gray-50 dark:bg-slate-800',
                    carousel ? 'object-cover' : 'object-contain',
                  ]}
                />
              )}
              <div class="p-4 flex flex-col gap-2 grow">
                <h3 class="text-lg font-semibold">
                  <a href={productHref(locale, p.id)} class="hover:underline">
                    {tx.name}
                  </a>
                </h3>
                {!compact && <p class="text-sm text-muted">{tx.directAnswer}</p>}
                {!compact && (
                  <p class="text-sm">
                    <span class="font-semibold">
                      {t.colors} ({p.data.colors.length}):{' '}
                    </span>
                    {p.data.colors.map((c) => {
                      const l = colorLabel(c);
                      return (
                        <span class="inline-block me-2" dir="auto">
                          <bdi>{l.code}</bdi> {l.name}
                        </span>
                      );
                    })}
                  </p>
                )}
                {href && (
                  <a
                    href={href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-secondary mt-auto inline-flex justify-center min-h-11"
                    data-wa-type="product"
                    data-wa-position="card"
                    data-wa-source={tx.name}
                  >
                    {t.ask}
                  </a>
                )}
              </div>
            </li>
          );
        })}
      </ul>
      {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
      {carousel && <script is:inline set:html={NAV_JS} />}
    </section>
  )
}
