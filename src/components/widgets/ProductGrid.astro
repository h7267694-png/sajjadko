---
// شبكة النماذج في صفحات الأقسام (6.1 بند 5): أول PAGE_SIZE منتجًا في الصفحة، والباقي بزر «عرض المزيد» من /frag/.
// ItemList في JSON-LD يذكر المنتجات المعروضة فقط (ما في HTML)، وكل المنتجات في الخريطة وصفحاتها.
import GridCard from '~/components/ui/GridCard.astro';
import LoadMore from '~/components/ui/LoadMore.astro';
import { getSettings, toLocale } from '~/utils/site';
import { productHref } from '~/utils/products';
import { gridItems, chunk, PAGE_SIZE } from '~/utils/lists';

export interface Props {
  /** مفتاح الصفحة (translationKey): اسم ملفات /frag/ */
  listKey: string;
  categories?: string[];
  places?: string[];
  services?: string[];
  pageName: string;
  title?: string;
}

const { listKey, categories, places, services, pageName, title } = Astro.props;
const lang = toLocale(Astro.currentLocale);
const settings = await getSettings();
const all = await gridItems(lang, { categories, places, services });
const [first = [], ...rest] = chunk(all, PAGE_SIZE);
const listId = `grid-${listKey}`;
const heading = title ?? (lang === 'ar' ? 'النماذج والألوان المتوفرة' : 'Available collections and colours');
const schema = first.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: heading,
      numberOfItems: all.length,
      itemListElement: first.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: p.data[lang]!.name,
        url: new URL(productHref(lang, p.id), Astro.site).href,
      })),
    }
  : null;
---

{
  first.length > 0 && (
    <section class="not-prose my-10" aria-labelledby="product-grid-title">
      <h2 id="product-grid-title" class="text-2xl font-bold mb-4">
        {heading}
      </h2>
      <ul id={listId} class="grid gap-6 sm:grid-cols-2">
        {first.map((p) => (
          <GridCard entry={p} lang={lang} pageName={pageName} whatsapp={settings?.whatsapp} />
        ))}
      </ul>
      <LoadMore
        lang={lang}
        list={`grid-${listKey}`}
        pages={rest.length}
        rest={all.length - first.length}
        target={listId}
      />
      {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    </section>
  )
}

<style>
  /* البطاقات البعيدة عن الشاشة لا تُرسم ولا تُطلب صورها حتى تقترب (Speed Index) */
  :global(.grid-card) {
    content-visibility: auto;
    contain-intrinsic-size: auto 520px;
  }
</style>
