---
import PageLayout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { getSettings } from '~/utils/site';
import { buildHomeSchema } from '~/utils/schema';
const settings = await getSettings();
const schema = settings ? buildHomeSchema(settings, 'en', Astro.site!) : [];
---

<PageLayout
  pageType="home"
  pageName="Home"
  alternates={{ en: '/', ar: '/ar/' }}
  metadata={{ title: 'Sajjadko Kuwait', ignoreTitleTemplate: true, description: 'Placeholder' }}
>
  <StructuredData slot="head" schema={schema} />
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-4xl font-bold">Sajjadko Kuwait</h1>
  </section>
</PageLayout>
