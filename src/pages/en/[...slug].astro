---
import type { GetStaticPaths } from 'astro';
import ContentPage from '~/components/widgets/ContentPage.astro';
import { getPageProps } from '~/utils/pages';

export const getStaticPaths = (async () => getPageProps('en')) satisfies GetStaticPaths;

const { entry, alternates, breadcrumbs, related } = Astro.props;
---

<ContentPage entry={entry} alternates={alternates} breadcrumbs={breadcrumbs} related={related} />
