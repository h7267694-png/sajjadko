---
// قالب صفحة التصنيف (6.1): H1 + واتساب (أعلى) + إجابة مباشرة + محتوى + واتساب (وسط) + أسئلة + روابط + معلومات النشاط + واتساب (ختام).
// المحتوى (الجدول، الأنواع، الشبكة، الدليل) يأتي عبر الـslot من الصفحة نفسها. الأقسام الاختيارية تُخفى عند غياب بياناتها.
import PageLayout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import AnswerBox from '~/components/ui/AnswerBox.astro';
import FaqList from '~/components/ui/FaqList.astro';
import RelatedLinks from '~/components/ui/RelatedLinks.astro';
import WhatsAppButton from '~/components/ui/WhatsAppButton.astro';
import FreeVisit from '~/components/ui/FreeVisit.astro';
import { getSettings, toLocale, formatPhone } from '~/utils/site';
import type { WaType } from '~/utils/whatsapp';

export interface Props {
  title: string;
  description: string;
  h1: string;
  directAnswer: string;
  updated?: string; // يُعرض فقط حين تحتوي الصفحة سعرًا
  faq: { q: string; a: string }[];
  breadcrumbs: { text: string; href?: string }[];
  related?: { text: string; href: string }[];
  alternates: { en?: string; ar?: string };
  pageType?: WaType;
  pageName: string;
}

const p = Astro.props;
const locale = toLocale(Astro.currentLocale);
const settings = await getSettings();
const t =
  locale === 'ar'
    ? { faq: 'أسئلة شائعة', related: 'صفحات ذات صلة', info: 'معلومات النشاط', short: 'الإجابة باختصار' }
    : { faq: 'Frequently asked questions', related: 'Related pages', info: 'Business details', short: 'In short' };
---

<PageLayout
  pageType={p.pageType ?? 'category'}
  pageName={p.pageName}
  alternates={p.alternates}
  metadata={{ title: p.title, description: p.description }}
>
  <Breadcrumbs bar items={p.breadcrumbs} />
  <article class="mx-auto max-w-3xl px-4 py-8 md:py-12">
    <h1 class="text-3xl md:text-4xl font-bold mb-4">{p.h1}</h1>
    <WhatsAppButton type={p.pageType ?? 'category'} pageName={p.pageName} position="top" />
    <AnswerBox answer={p.directAnswer} updated={p.updated} label={t.short} />
    <FreeVisit pageName={p.pageName} />
    <slot />
    <div class="my-8"><WhatsAppButton type={p.pageType ?? 'category'} pageName={p.pageName} position="mid" /></div>
    <FaqList items={p.faq} title={t.faq} />
    <RelatedLinks links={p.related ?? []} title={t.related} />
    {
      settings && (
        <section class="my-10">
          <h2 class="text-xl font-bold mb-2">{t.info}</h2>
          <address class="not-italic space-y-1">
            {settings.address?.[locale] && <p>{settings.address[locale]}</p>}
            {settings.hours?.[locale] && <p>{settings.hours[locale]}</p>}
            {settings.whatsapp && (
              <p>
                <bdi dir="ltr">{formatPhone(settings.whatsapp)}</bdi>
              </p>
            )}
          </address>
        </section>
      )
    }
    <WhatsAppButton type={p.pageType ?? 'category'} pageName={p.pageName} position="end" />
  </article>
</PageLayout>
