---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';

import { getHeaderLinks, getFooterData } from '~/navigation';
import { toLocale, homeHref } from '~/utils/site';
import type { WaType } from '~/utils/whatsapp';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
  alternates?: { en?: string; ar?: string };
  /** نوع صفحة واتساب (7.2) واسم الصفحة لوسم المصدر */
  pageType?: WaType;
  pageName?: string;
}

const { metadata, alternates, pageType = 'category', pageName } = Astro.props;
const locale = toLocale(Astro.currentLocale);
// زر اللغة ظاهر دائمًا: إلى ترجمة الصفحة إن وُجدت، وإلا إلى رئيسية اللغة الأخرى (صفحات عربية فقط)
const other = locale === 'ar' ? 'en' : 'ar';
const altHref = alternates?.[other] ?? homeHref(other);
---

<Layout metadata={metadata} alternates={alternates}>
  <slot name="head" slot="head" />
  {
    /*
    Slot fallbacks are rendered explicitly. With `<slot name="x">fallback</slot>`
    Astro still evaluates the fallback when the page overrides the slot, and
    astro-icon then believes the icons inside it (the RSS icon of the default
    header, for instance) were already emitted, so their SVG sprite symbol
    goes missing on that page.
  */
  }
  {Astro.slots.has('announcement') && <slot name="announcement" />}
  {
    Astro.slots.has('header') ? (
      <slot name="header" />
    ) : (
      <Header links={getHeaderLinks(locale)} isSticky showToggleTheme {pageType} {pageName} {altHref} />
    )
  }
  <main class="flex-1">
    <slot />
  </main>
  {Astro.slots.has('footer') ? <slot name="footer" /> : <Footer {...getFooterData(locale)} />}
</Layout>
