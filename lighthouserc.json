{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/en/index.html",
        "http://localhost/zawali/index.html",
        "http://localhost/products/remal-plush/index.html"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500,
            "aggregationMethod": "median"
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05,
            "aggregationMethod": "median"
          }
        ],
        "speed-index": [
          "error",
          {
            "maxNumericValue": 3400,
            "aggregationMethod": "median"
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 200,
            "aggregationMethod": "median"
          }
        ],
        "render-blocking-resources": [
          "warn",
          {
            "maxLength": 0
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
